# Copy to .env and replace local passwords before startup. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-local-password
DATABASE_URL=postgresql+psycopg://knowdoc:replace-with-a-long-random-local-password@127.0.0.1:54329/knowdoc
# After migration, scripts/provision_local.py creates knowdoc_app and adds these values:
# MIGRATION_DATABASE_URL=<original administrative URL>
# DATABASE_APP_PASSWORD=<generated runtime password>
STORAGE_DIR=data/uploads
OLLAMA_URL=http://127.0.0.1:11434
EMBEDDING_BACKEND=ollama
EMBEDDING_MODEL=nomic-embed-text:latest
EMBEDDING_DIM=768
# Pin the digest returned by the local Ollama /api/tags endpoint; reindex after any change.
EMBEDDING_DIGEST=
GENERATION_MODEL=gemma:2b
ALLOW_REMOTE_PROVIDER=false
COOKIE_SECURE=false
WEB_ORIGIN=http://127.0.0.1:5173
